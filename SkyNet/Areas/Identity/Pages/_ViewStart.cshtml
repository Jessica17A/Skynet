@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
﻿

    @{
        if (User?.Identity != null && User.Identity.IsAuthenticated)
        {
            if (User.IsInRole("Administrador"))
            {
                Layout = "/Views/Shared/_Admin.cshtml"; // Layout para Admin
            }
            else if (User.IsInRole("Supervisor"))
            {
                Layout = "/Views/Shared/_Supervisor.cshtml"; // Layout para Supervisor
            }
            else if (User.IsInRole("Tecnico"))
            {
                Layout = "/Views/Shared/_Tecnico.cshtml"; // Layout para Técnico
            }

        }
        else
        {
            Layout = "/Views/Shared/_Layout.cshtml"; // Layout para usuarios no autenticados
        }
    }