@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div class="flex-grow-1">
            <h2 class="mb-1 text-truncate">Dashboard de SkyNet</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Visitas" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Nueva visita
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Clientes" asp-action="Create">
                <i class="bi bi-person-plus me-1"></i> Nuevo cliente
            </a>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width:44px;height:44px;">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Clientes</div>
                            <div class="fs-4 fw-semibold">120</div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:.4rem;">
                        <div class="progress-bar bg-primary" style="width: 72%"></div>
                    </div>
                    <div class="text-muted small mt-1">+12 este mes</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3" style="width:44px;height:44px;">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Visitas hoy</div>
                            <div class="fs-4 fw-semibold">35</div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:.4rem;">
                        <div class="progress-bar bg-success" style="width: 60%"></div>
                    </div>
                    <div class="text-muted small mt-1">70% completadas</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center me-3" style="width:44px;height:44px;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Pendientes</div>
                            <div class="fs-4 fw-semibold">14</div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:.4rem;">
                        <div class="progress-bar bg-warning" style="width: 40%"></div>
                    </div>
                    <div class="text-muted small mt-1">SLA 2h promedio</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3" style="width:44px;height:44px;">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Fuera de rango</div>
                            <div class="fs-4 fw-semibold">2</div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:.4rem;">
                        <div class="progress-bar bg-danger" style="width: 15%"></div>
                    </div>
                    <div class="text-muted small mt-1">Revisar ubicaciones</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfica + tabla -->
    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex align-items-center justify-content-between bg-white">
                    <span class="fw-semibold">Visitas por día (últimos 7)</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-outline-secondary active">Semana</button>
                        <button class="btn btn-outline-secondary">Mes</button>
                    </div>
                </div>
                <div class="card-body">
                    <div style="height:300px;">
                        <canvas id="chartVisitas"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <span class="fw-semibold">Visitas de hoy</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Técnico</th>
                                    <th class="d-none d-sm-table-cell">Cliente</th>
                                    <th class="d-none d-sm-table-cell">Hora</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>JFlores</td>
                                    <td class="d-none d-sm-table-cell">Comercial XYZ</td>
                                    <td class="d-none d-sm-table-cell">09:30</td>
                                    <td><span class="badge bg-success">Finalizada</span></td>
                                </tr>
                                <tr>
                                    <td>MLuna</td>
                                    <td class="d-none d-sm-table-cell">Hotel Central</td>
                                    <td class="d-none d-sm-table-cell">10:15</td>
                                    <td><span class="badge bg-info text-dark">En curso</span></td>
                                </tr>
                                <tr>
                                    <td>ARamírez</td>
                                    <td class="d-none d-sm-table-cell">Farmacia Los Olivos</td>
                                    <td class="d-none d-sm-table-cell">11:00</td>
                                    <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                                </tr>
                                <tr>
                                    <td>RCano</td>
                                    <td class="d-none d-sm-table-cell">Rest. El Mirador</td>
                                    <td class="d-none d-sm-table-cell">11:30</td>
                                    <td><span class="badge bg-danger">Reprogramar</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 text-end">
                        <a asp-controller="Visitas" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('chartVisitas');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'],
                datasets: [{
                    label: 'Visitas',
                    data: [12, 18, 14, 22, 19, 25, 20],
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 5 } }
                }
            }
        });
    </script>
}
