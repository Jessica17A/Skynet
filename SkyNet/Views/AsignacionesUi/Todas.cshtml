<div class="text-center mb-4 position-sticky top-0" style="z-index: 1030;">
    <div class="p-3 rounded-0 bg-success text-white shadow-sm">
        <h2 class="mb-0">Visitas programadas</h2>
    </div>
</div>

<div id="cards" class="row g-4"></div>

<style>
    .chip {
        display: inline-flex;
        align-items: center;
        gap: .375rem;
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 999px;
        padding: .25rem .5rem;
        background: #fff;
        margin: .25rem .375rem .25rem 0;
        box-shadow: 0 1px 1.5px rgba(0,0,0,.06);
        font-size: .95rem;
    }

    .icon-sm {
        font-size: 1rem;
        line-height: 1;
    }

    .meta {
        font-size: .925rem;
        color: #6c757d;
    }
</style>

<script>
    (function () {
      const base = `${window.location.origin}${document.body.getAttribute("data-pathbase") ?? ""}`;

      function groupBySolicitud(rows) {
        const map = new Map();
        for (const a of rows) {
          if (!map.has(a.idSolicitud)) map.set(a.idSolicitud, []);
          map.get(a.idSolicitud).push(a);
        }
        return Array.from(map.entries()).sort((a,b) => a[0]-b[0]);
      }

      function unique(arr) { return [...new Set(arr)]; }

      async function run() {
        const host = document.getElementById('cards');
        const res = await fetch(`${base}/api/solicitudes/asignaciones`);
        if (!res.ok) {
          host.innerHTML = `<div class="col-12">
            <div class="alert alert-danger">No se pudo cargar el listado.</div></div>`;
          return;
        }
        const data = await res.json();
        if (!Array.isArray(data) || data.length === 0) {
          host.innerHTML = `<div class="col-12"><div class="alert alert-info m-0">No hay asignaciones.</div></div>`;
          return;
        }

        const grouped = groupBySolicitud(data);

        host.innerHTML = grouped.map(([idSolicitud, asignaciones]) => {
          asignaciones.sort((x, y) => (x.tecnicoNombre||'').localeCompare(y.tecnicoNombre||''));

          const chipsTecnicos = asignaciones.map(a => `
            <span class="chip">
              <i class="bi bi-person-badge-fill icon-sm text-primary"></i>
              <span>${a.tecnicoNombre ?? a.fkTecnico}</span>
            </span>
          `).join('');

          const supervisores = unique(asignaciones.map(a => a.supervisorNombre ?? '-')).join(', ');
          const inicioMin = asignaciones.reduce((acc,a)=>{
            const dt = a.fecha_Inicio ? new Date(a.fecha_Inicio) : null;
            if(!dt) return acc;
            return (!acc || dt<acc) ? dt : acc;
          }, null);

          // 👇 Ícono de estado
          const has4 = asignaciones.some(a => a.estado === 4);
          const has3 = asignaciones.some(a => a.estado === 3);
          const estadoIcon = has4
            ? `<span class="spinner-border spinner-border-sm text-warning me-2" role="status" aria-hidden="true"></span>
               <i class="bi bi-bus-front-fill text-warning" title="En proceso"></i>`
            : (has3 ? `<i class="bi bi-check-circle-fill text-success" title="Completado"></i>` : ``);

          return `
            <div class="col-12 col-md-6 col-lg-3">
              <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body d-flex flex-column">

                  <div class="d-flex justify-content-between align-items-center mb-2">
                          <a class="h5 mb-0 text-decoration-none" href="${base}/AsignacionesUi/Detalle/${asignaciones[0].idSolicitud}">
                            <i class="bi bi-journal-text text-primary"></i>
                            <span class="text-primary fw-bold">Solicitud #${asignaciones[0].idSolicitud}</span>
                          </a>
                          ${estadoIcon}
                  </div>

                  <div class="meta mb-2">
                    <div>
                      <i class="bi bi-person-workspace text-warning"></i>
                      <strong>Supervisor(es):</strong> ${supervisores}
                    </div>
                    <div class="mt-1">
                      <i class="bi bi-calendar2-week text-success"></i>
                      <strong>Fecha de Visita:</strong> ${inicioMin ? inicioMin.toLocaleDateString() : '-'}
                    </div>
                  </div>

                  <div class="mb-2">
                    <div class="mb-1">
                      <i class="bi bi-person-lines-fill text-primary"></i>
                      <strong>Técnicos:</strong>
                    </div>
                    <div>
                      ${chipsTecnicos}
                    </div>
                  </div>

                  <div class="mt-auto">
                    <a class="btn btn-primary w-100"
                       href="${base}/AsignacionesUi/Detalle/${encodeURIComponent(idSolicitud)}">
                       <i class="bi bi-eye"></i> Ver detalles
                    </a>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      run();
    })();
</script>
