@model IEnumerable<SkyNet.Models.Usuarios.UsuarioListadoVm>
@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="mb-0">Usuarios</h2>
        <div class="d-flex gap-2">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Nuevo usuario
            </a>
            <a asp-controller="Empleados" asp-action="Create" class="btn btn-outline-secondary">
                <i class="bi bi-person-add me-1"></i> Nuevo empleado
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="d-none d-md-table-cell">Cargo</th>
                        <th>Usuario</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th class="d-none d-sm-table-cell">Roles</th>
                        <th class="d-none d-sm-table-cell">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                @if (u.EmpleadoId.HasValue)
                                {
                                    <span>@u.NombreCompleto</span>
                                }
                                else
                                {
                                    <span class="text-muted">— sin enlace —</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@u.Cargo</td>
                            <td>@u.UserName</td>
                            <td class="d-none d-lg-table-cell">@u.Email</td>
                            <td class="d-none d-sm-table-cell">@u.Roles</td>
                            <td class="d-none d-sm-table-cell">
                                @if (u.Estado == 1)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else if (u.Estado == 0)
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">N/D</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-controller="Usuarios" asp-action="ToggleEstado" asp-route-id="@u.UserId"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-power"></i>
                                    </a>
                                    <a asp-controller="Usuarios" asp-action="ResetPassword" asp-route-id="@u.UserId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @* Si tienes detalle/edición *@
                                    <a asp-controller="Empleados" asp-action="Edit" asp-route-id="@u.EmpleadoId"
                                       class="btn btn-sm btn-outline-primary" title="Editar empleado"
                                       disabled="@(u.EmpleadoId == null)">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
