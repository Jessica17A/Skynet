@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="mb-0">Usuarios</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i> Nuevo usuario
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped align-middle mb-0" id="tblUsers">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="d-none d-md-table-cell">Cargo</th>
                        <th>Usuario</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th class="d-none d-sm-table-cell">Roles</th>
                        <th class="d-none d-sm-table-cell">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (async function() {
            const apiBase = `${location.protocol}//${location.host}/api/usuarios`;

            async function loadUsers() {
                const res = await fetch(apiBase);
                if (!res.ok) { alert('No se pudo cargar usuarios'); return; }
                const data = await res.json();

                const tbody = document.querySelector('#tblUsers tbody');
                tbody.innerHTML = '';

                for (const u of data) {
                    const nombre = u.empleadoId ? (u.nombreCompleto ?? '') : '<span class="text-muted">— sin enlace —</span>';
                    const estadoBadge = (u.estado === 1)
                        ? '<span class="badge bg-success">Activo</span>'
                        : (u.estado === 0)
                            ? '<span class="badge bg-secondary">Inactivo</span>'
                            : '<span class="badge bg-warning text-dark">N/D</span>';

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${nombre}</td>
                        <td class="d-none d-md-table-cell">${u.cargo ?? ''}</td>
                        <td>${u.userName ?? ''}</td>
                        <td class="d-none d-lg-table-cell">${u.email ?? ''}</td>
                        <td class="d-none d-sm-table-cell">${u.roles ?? ''}</td>
                        <td class="d-none d-sm-table-cell">${estadoBadge}</td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-warning" data-action="toggle" data-id="${u.userId}" data-estado="${u.estado ?? 0}" title="Activar/Desactivar">
                                    <i class="bi bi-power"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-action="delete" data-id="${u.userId}" title="Soft-delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                }
            }

            document.querySelector('#tblUsers tbody').addEventListener('click', async (ev) => {
                const btn = ev.target.closest('button[data-action]');
                if (!btn) return;
                const id = btn.getAttribute('data-id');
                const action = btn.getAttribute('data-action');

                if (action === 'toggle') {
                    const current = Number(btn.getAttribute('data-estado') ?? '0');
                    const next = current === 1 ? 0 : 1;

                    const resp = await fetch(`${apiBase}/${id}/estado`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ estado: next })
                    });
                    if (resp.ok) loadUsers();
                    else alert('No se pudo actualizar el estado');
                }

                if (action === 'delete') {
                    if (!confirm('¿Desactivar este usuario (soft-delete)?')) return;
                    const resp = await fetch(`${apiBase}/${id}`, { method: 'DELETE' });
                    if (resp.ok) loadUsers();
                    else alert('No se pudo desactivar el usuario');
                }
            });

            await loadUsers();
        })();
    </script>
}
