@{
    ViewData["Title"] = "Tracking de solicitud";
    var solicitudId = (long)ViewBag.SolicitudId;
}

<!-- Encabezado -->
<div class="text-center mb-4">   
    <h3 class="fw-bold mb-1">
        <span class="text-secondary">Tracking ·</span> Solicitud No. @solicitudId
    </h3>  
</div>


<!-- Card contenedora -->
<div class="card shadow-sm border-0">
    <div class="card-body">

        <div class="timeline-container">
            <ul id="timeline" class="timeline">
                <li class="loading text-secondary text-center">Cargando…</li>
            </ul>
        </div>

    </div>
</div>

<style>
    /* ===== CONTENEDOR GENERAL ===== */
    .timeline-container {
        overflow-x: auto;
        white-space: nowrap;
        padding: 6px 0 18px;
    }

    .timeline {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        list-style: none;
        padding: 0;
        position: relative;
        min-width: 850px;
        margin: 0;
    }

        /* ===== CONECTOR ===== */
        .timeline::before {
            content: "";
            position: absolute;
            top: 36px;
            left: 0;
            right: 0;
            height: 3px;
            background: #e9ecef;
            z-index: 1;
        }

    /* ===== CADA PASO ===== */
    .timeline-step {
        position: relative;
        text-align: center;
        flex: 1;
        z-index: 2;
        padding: 0 .5rem;
    }

        .timeline-step .circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: var(--color, #ccc);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.05rem;
            box-shadow: 0 3px 8px rgba(0, 0, 0, .15);
            transition: transform .2s;
        }

        .timeline-step.active .circle {
            transform: scale(1.15);
        }

        /* ===== TEXTO ===== */
        .timeline-step .title {
            font-weight: 800;
            color: var(--color, #6c757d);
            font-size: .9rem;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .timeline-step .date {
            font-size: .8rem;
            color: #6c757d;
            line-height: 1.1;
        }

        .timeline-step .user {
            font-size: .86rem;
            color: #212529;
            font-weight: 600;
            margin-top: 6px;
        }

        /* ===== ÍCONO BAJO NOMBRE ===== */
        .timeline-step .icon {
            display: block;
            font-size: 1.05rem;
            margin-top: 6px;
            color: var(--color, #ccc);
        }

    /* ===== COLORES POR ESTADO ===== */
    .step-0 {
        --color: #e74c3c;
    }
    /* Rechazada */
    .step-1 {
        --color: #6c757d;
    }
    /* Creada */
    .step-2 {
        --color: #0dcaf0;
    }
    /* Revisada */
    .step-3 {
        --color: #20c997;
    }
    /* Aceptada */
    .step-4 {
        --color: #ffc107;
    }
    /* En proceso */
    .step-5 {
        --color: #0d6efd;
    }
    /* Finalizada */

    .loading {
        width: 100%;
        padding: 1rem;
        text-align: center;
    }

    /* Opcional: resalta el último estado */
    .timeline-step.last .title,
    .timeline-step.last .icon {
        filter: saturate(1.1) drop-shadow(0 0 0 transparent);
    }

    .timeline-step.last .circle {
        box-shadow: 0 4px 14px rgba(13,110,253,.25);
    }
</style>

<script>
    (() => {
      const solicitudId = @solicitudId;
      const apiUrl = '@Url.Content("~/api/solicitudes/")' + solicitudId + '/tracking';
      const $timeline = document.getElementById('timeline');

      // Íconos bonitos por estado
      const META = {
        0: { name: 'Rechazada',  icon: 'bi-x-octagon-fill' },
        1: { name: 'Creada',     icon: 'bi-file-earmark-plus-fill' },
        2: { name: 'Revisada',   icon: 'bi-search-heart-fill' },
        3: { name: 'Aceptada',   icon: 'bi-patch-check-fill' },
        4: { name: 'En proceso', icon: 'bi-rocket-takeoff-fill' },
        5: { name: 'Finalizada', icon: 'bi-flag-fill' },
      };

      const esc = s => (s ?? "").toString().replace(/[&<>"']/g, m => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[m]));
      const fmt = iso => {
        const d = new Date(iso);
        if (isNaN(d)) return "";
        const fecha = d.toLocaleDateString("es-GT");
        const hora  = d.toLocaleTimeString("es-GT",{hour:"2-digit",minute:"2-digit",second:"2-digit"});
        return `${fecha}<br><small>${hora}</small>`;
      };

      function stepTpl(x, isLast) {
        const st = Number(x.estado);
        const meta = META[st] ?? { name: x.estadoTexto || 'Evento', icon: 'bi-record-circle' };
        const clsLast = isLast ? ' last' : '';
        return `
          <li class="timeline-step step-${st}${clsLast}">
            <div class="circle"><i class="bi ${meta.icon}"></i></div>
            <div class="title">${esc((x.estadoTexto || meta.name)).toUpperCase()}</div>
            <div class="date">
                <i class="bi bi-calendar2-week me-1"></i>${fmt(x.fechaUtc)}
            </div>
            <div class="user">
                <i class="bi bi-person-circle me-1 text-primary"></i>${esc(x.usuario)}
            </div>
            <i class="icon bi ${meta.icon}"></i>
          </li>`;
      }

      async function cargar() {
        try {
          const res = await fetch(apiUrl, { credentials: "same-origin" });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();

          if (!Array.isArray(data) || data.length === 0) {
            $timeline.innerHTML = `<li class="text-muted text-center py-3">Sin eventos registrados.</li>`;
            return;
          }

          data.sort((a, b) => new Date(a.fechaUtc) - new Date(b.fechaUtc));
          $timeline.innerHTML = data.map((x, i) => stepTpl(x, i === data.length - 1)).join("");
        } catch (err) {
          $timeline.innerHTML = `<li class="text-danger text-center py-3"><i class="bi bi-exclamation-octagon me-1"></i>Error al cargar: ${esc(String(err))}</li>`;
        }
      }

      document.addEventListener("DOMContentLoaded", cargar);
    })();
</script>
