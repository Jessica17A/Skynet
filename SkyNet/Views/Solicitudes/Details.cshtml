@model SkyNet.Models.DTOs.SolicitudDto
@{
    ViewData["Title"] = "Detalle solicitud";
    // Layout = "~/Views/Shared/_Admin.cshtml";

    string EstadoNombre(int e) => e switch
    {
        0 => "Rechazado",
        1 => "Pendiente",
        2 => "Revisada",
        3 => "Aceptada",
        4 => "En proceso",
        5 => "Finalizado",
        _ => "Desconocido"
    };
    string EstadoBadge(int e) => e switch
    {
        0 => "badge rounded-pill px-3 py-2 bg-danger",
        1 => "badge rounded-pill px-3 py-2 bg-secondary",
        2 => "badge rounded-pill px-3 py-2 bg-info",
        3 => "badge rounded-pill px-3 py-2 bg-success",
        4 => "badge rounded-pill px-3 py-2 bg-warning text-dark",
        5 => "badge rounded-pill px-3 py-2 bg-primary",
        _ => "badge rounded-pill px-3 py-2 bg-dark"
    };
    string PriClass(string? p) => (p ?? "").Trim().ToLower() switch
    {
        "alta" => "chip chip-lg bg-danger text-white",
        "media" => "chip chip-lg bg-warning text-dark",
        "baja" => "chip chip-lg bg-success text-white",
        _ => "chip chip-lg bg-light text-dark border"
    };

    var steps = new (int val, string name)[] {
        (1,"Pendiente"), (2,"Revisada"), (3,"Aceptada"), (4,"En proceso"), (5,"Finalizado")
    };

    var lat = Model.Latitud;
    var lng = Model.Longitud;
    var hasCoords = lat.HasValue && lng.HasValue;
    var q = hasCoords ? $"{lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lng.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
                      : (Model.Direccion ?? Model.Nombre ?? "Guatemala");
}

<style>
    .chip {
        display: inline-block;
        padding: .35rem .9rem;
        border-radius: 50px;
        font-size: .85rem;
        line-height: 1;
        background: #f0f4f8;
        color: #333;
        border: 1px solid #d1d9e6;
        box-shadow: 0 2px 4px rgba(0,0,0,.08)
    }

    .chip-lg {
        padding: .45rem 1rem;
        font-size: .95rem
    }

    .btn-pill {
        border-radius: 999px;
        padding: .45rem 1rem;
        font-weight: 600
    }

    /* ------ STEP PROGRESIVO LLAMATIVO ------ */
    .stepper-wrap {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px
    }

    .stepper-title {
        font-weight: 700;
        color: #0b5ed7;
        margin-bottom: .35rem
    }

    .stepper {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center
    }

    .step-dot {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        font-weight: 800;
        border: 2px solid #cbd5e1;
        background: #fff;
        color: #64748b;
        box-shadow: 0 2px 4px rgba(2,6,23,.06)
    }

        .step-dot.done {
            background: #e7f1ff;
            color: #0d6efd;
            border-color: #cfe2ff
        }

        .step-dot.active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd
        }

    .step-label {
        font-size: .95rem;
        color: #334155;
        font-weight: 700
    }

    .step-link {
        width: 64px;
        height: 4px;
        background: #e2e8f0;
        border-radius: 3px;
        box-shadow: inset 0 0 0 1px #e2e8f0
    }

        .step-link.done {
            background: #0d6efd
        }

    /* ------ DESCRIPCIÓN: que no se salga ------ */
    .desc-card {
        display: flex;
        flex-direction: column;
        height: 100%
    }

    .desc-box {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 12px;
        min-height: 84px; /* asegura un bloque visual */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /* Mapa compacto */
    .map-frame {
        width: 100%;
        height: 260px;
        border: 0;
        border-radius: .5rem;
    }
</style>

<div class="container mt-3" id="solicitud" data-id="@Model.Id" data-estado="@((int)Model.Estado)">
    <!-- CABECERA + SIGUIENTES PASOS ARRIBA -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h4 class="mb-1"><i class="bi bi-receipt"></i> Ticket <strong>@Model.Ticket</strong></h4>
            <span id="estadoBadge" class="@EstadoBadge((int)Model.Estado)">@EstadoNombre((int)Model.Estado)</span>
        </div>
        <div class="text-end">
            <div class="fw-semibold small text-muted mb-1">Siguientes pasos</div>
            <div id="acciones" class="d-flex flex-wrap gap-2 justify-content-end"></div>
        </div>
    </div>

    <!-- STEPPER -->
    <div class="stepper-wrap mb-3">
        <div class="stepper-title"><i class="bi bi-diagram-3"></i> Flujo de estados</div>
        <div id="stepper" class="stepper">
            @{
                var curr = (int)Model.Estado;
                for (var i = 0; i < steps.Length; i++)
                {
                    var s = steps[i];
                    var dotCls = s.val < curr ? "step-dot done" : (s.val == curr ? "step-dot active" : "step-dot");
                    <div class="d-flex align-items-center gap-2">
                        <div class="@dotCls">@s.val</div>
                        <div class="step-label">@s.name</div>
                    </div>
                    if (i < steps.Length - 1)
                    {
                        var linkCls = steps[i].val < curr ? "step-link done" : "step-link";
                        <div class="@linkCls"></div>
                    }
                }
            }
        </div>
    </div>

    <!-- DATOS -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombre</label>
                            <div>@Model.Nombre</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Email</label>
                            <div>@Model.Email</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Teléfono</label>
                            <div>@(Model.Telefono ?? "-")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Tipo</label>
                            <div><span class="@PriClass(Model.Prioridad)">@Model.Tipo</span></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Prioridad</label>
                            <div><span class="@PriClass(Model.Prioridad)">@Model.Prioridad</span></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Creado (UTC)</label>
                            <div>@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Dirección</label>
                            <div>@(Model.Direccion ?? "-")</div>
                        </div>
                    </div>
                </div>

                <!-- Descripción con contenedor propio -->
                <div class="col-lg-4">
                    <div class="desc-card">
                        <label class="form-label fw-bold">Descripción</label>
                        <div class="desc-box">@Model.Descripcion</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAPA COMPACTO + SOLO DOS BOTONES -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary d-flex justify-content-between">
            <span><i class="bi bi-geo-alt"></i> Ubicación y cómo llegar</span>
            @if (hasCoords)
            {
                <small class="text-muted">Lat: @lat, Lng: @lng</small>
            }
        </div>
        <div class="card-body">
            <iframe class="map-frame"
                    loading="lazy" allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q=@Uri.EscapeDataString(q)&hl=es&z=16&output=embed">
            </iframe>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a class="btn btn-outline-primary btn-pill"
               href="https://www.google.com/maps/dir/?api=1&destination=@Uri.EscapeDataString(q)"
               target="_blank" rel="noopener">
                <i class="bi bi-signpost-2"></i> Cómo llegar (Google Maps)
            </a>
            <a class="btn btn-outline-dark btn-pill"
               href="https://waze.com/ul?@(hasCoords ? $"ll={lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lng!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&navigate=yes" : $"q={Uri.EscapeDataString(q)}&navigate=yes")"
               target="_blank" rel="noopener">
                <i class="bi bi-geo"></i> Abrir en Waze
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (() => {
          const estados = {
            0: { text: "Rechazado",  cls: "btn btn-pill btn-outline-danger" },
            1: { text: "Pendiente",  cls: "btn btn-pill btn-info text-white" },
            2: { text: "Revisada",   cls: "btn btn-pill btn-primary" },
            3: { text: "Aceptada",   cls: "btn btn-pill btn-success" },
            4: { text: "En proceso", cls: "btn btn-pill btn-warning text-dark" },
            5: { text: "Finalizado", cls: "btn btn-pill btn-primary" }
          };

          function siguiente(curr){
            switch(curr){ case 1:return 2; case 2:return 3; case 3:return 4; case 4:return 5; default:return null; }
          }

          function renderBotones(){
            const cont = document.getElementById('solicitud');
            const id   = cont.dataset.id;
            const curr = parseInt(cont.dataset.estado,10);
            const zone = document.getElementById('acciones');
            zone.innerHTML = '';

            if (curr!==0 && curr!==5){
              const nxt = siguiente(curr);
              if (curr===4){
                const bFin = document.createElement('button');
                bFin.className = estados[5].cls; bFin.textContent = estados[5].text;
                bFin.onclick = () => onCambiarEstado(id,5);
                zone.appendChild(bFin);
              } else if (nxt!==null){
                const bNext = document.createElement('button');
                bNext.className = estados[nxt].cls; bNext.textContent = estados[nxt].text;
                bNext.onclick = () => onCambiarEstado(id,nxt);
                zone.appendChild(bNext);
              }
              if (curr>=1 && curr<=4){
                const bRej = document.createElement('button');
                bRej.className = estados[0].cls; bRej.textContent = 'Rechazar';
                bRej.onclick = () => onCambiarEstado(id,0);
                zone.appendChild(bRej);
              }
            }
          }

          async function confirmarCambio(curr,nuevo){
            const { isConfirmed } = await Swal.fire({
              icon:'question', title:'¿Confirmar cambio de estado?',
              html:`<div class="text-start">
                      <div><b>Actual:</b> ${curr}</div>
                      <div><b>Nuevo:</b> ${nuevo}</div>
                      ${nuevo===5?'<div class="mt-2 text-danger"><b>Nota:</b> esto marcará la solicitud como finalizada.</div>':''}
                    </div>`,
              showCancelButton:true, confirmButtonText:'Sí, continuar', cancelButtonText:'Cancelar',
              reverseButtons:true, focusCancel:true
            });
            return isConfirmed;
          }

          async function ajaxCambiarEstado(id,nuevo){
            const resp = await fetch(`/api/solicitudes/${id}/estado`,{
              method:'PATCH', headers:{'Content-Type':'application/json'},
              body:JSON.stringify({estado:nuevo})
            });
            if(!resp.ok) throw new Error('No se pudo actualizar el estado.');
            return true;
          }

          async function onCambiarEstado(id,nuevo){
            const zone=document.getElementById('acciones');
            const cont=document.getElementById('solicitud');
            const curr=parseInt(cont.dataset.estado,10);
            zone.querySelectorAll('button').forEach(b=>b.disabled=true);

            try{
              if(nuevo===3){
                const r=await Swal.fire({title:"Asignar técnico",text:"Para dar seguimiento debe asignar un técnico.",
                  icon:"info",showCancelButton:true,confirmButtonText:"Continuar",cancelButtonText:"Cancelar",reverseButtons:true});
                if(r.isConfirmed){ window.location.href=`/ui/asignaciones/Asignar?solicitudId=${id}`; }
                else { zone.querySelectorAll('button').forEach(b=>b.disabled=false); }
                return;
              }

              if(nuevo===0){
                const rj=await Swal.fire({title:"¿Rechazar solicitud?",text:"Esto también cancelará las asignaciones vinculadas.",
                  icon:"warning",showCancelButton:true,confirmButtonText:"Sí, rechazar",cancelButtonText:"Cancelar", reverseButtons: true});
                if(!rj.isConfirmed){ zone.querySelectorAll('button').forEach(b=>b.disabled=false); return; }
              }else{
                const ok=await confirmarCambio(curr,nuevo);
                if(!ok){ zone.querySelectorAll('button').forEach(b=>b.disabled=false); return; }
              }

              await ajaxCambiarEstado(id,nuevo);
              location.reload();
            }catch(e){
              Swal.fire('Error', e.message || 'No se pudo actualizar el estado.', 'error');
              zone.querySelectorAll('button').forEach(b=>b.disabled=false);
            }
          }

          document.addEventListener('DOMContentLoaded', renderBotones);
        })();
    </script>
}
