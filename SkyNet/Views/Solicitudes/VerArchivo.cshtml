@model VerArchivoVm
@{
    ViewData["Title"] = "Archivo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-paperclip"></i> Archivo</h5>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" href="@Model.Url" target="_blank" rel="noopener">
                Abrir en pestaña
            </a>
            <a class="btn btn-sm btn-outline-secondary" href="javascript:history.back()">
                Volver
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.EsImagen)
            {
                <img src="@Model.Url" class="img-fluid rounded border" alt="@Model.PublicId" />
            }
            else
            {
                <div class="ratio ratio-16x9">
                    <iframe src="@Model.Url" title="@Model.PublicId" loading="lazy"></iframe>
                </div>
                <div class="mt-3">
                    <a class="btn btn-sm btn-primary" href="@Model.Url" target="_blank" rel="noopener">Abrir / Descargar</a>
                </div>
            }
        </div>
    </div>
</div>
