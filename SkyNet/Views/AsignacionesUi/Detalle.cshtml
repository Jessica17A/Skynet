@using SkyNet.Models.DTOs
@{
    Layout = "~/Views/Shared/_Admin.cshtml";
    var sol = (SolicitudDto)ViewBag.Solicitud;

    string EstadoNombre(int e) => e switch
    {
        0 => "Rechazado",
        1 => "Pendiente",
        2 => "Revisada",
        3 => "Aceptada",
        4 => "En proceso",
        5 => "Finalizado",
        _ => "Desconocido"
    };

    var steps = new (int val, string name)[] {
        (1,"Pendiente"), (2,"Revisada"), (3,"Aceptada"), (4,"En proceso"), (5,"Finalizado")
    };
}

<style>
    .flow {display:flex;align-items:center;gap:1rem;flex-wrap:wrap;justify-content:center}
    .dot{width:36px;height:36px;border-radius:999px;display:grid;place-items:center;font-weight:700;border:2px solid var(--bs-border-color);background:#fff;color:#6c757d}
    .dot.done{background:#e7f1ff;color:#0d6efd;border-color:#cfe2ff}
    .dot.active{background:#0d6efd;color:#fff;border-color:#0d6efd}
    .link{width:56px;height:3px;background:var(--bs-border-color);border-radius:2px}
    .link.done{background:#0d6efd}
    .card-assign{border:1px solid #e6eef5;border-radius:16px;box-shadow:0 6px 20px rgba(16,24,40,.06)}
    .chip{display:inline-block;padding:.35rem .8rem;border-radius:999px;background:#f1f5fe;border:1px solid #dbe6ff;font-size:.82rem}
</style>

<div class="container mt-4" id="vDetalle" data-id="@sol.Id" data-estado="@((int)sol.Estado)">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-people"></i> Asignaciones de Ticket <strong>@sol.Ticket</strong></h4>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Solicitudes" asp-action="Details" asp-route-id="@sol.Id">
            <i class="bi bi-arrow-left"></i> Volver a detalle
        </a>
    </div>

    <!-- Tracking -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="flow">
                @{
                    var curr = (int)sol.Estado;
                    for (int i = 0; i < steps.Length; i++)
                    {
                        var s = steps[i];
                        var dotCls = s.val < curr ? "dot done" : (s.val == curr ? "dot active" : "dot");
                        <div class="d-flex align-items-center gap-2">
                            <div class="@dotCls">@s.val</div>
                            <div class="fw-semibold">@s.name</div>
                        </div>
                        if (i < steps.Length - 1)
                        {
                            var lk = steps[i].val < curr ? "link done" : "link";
                            <div class="@lk"></div>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Botón crear nueva asignación -->
    <div class="d-flex justify-content-end mb-2">
        <a class="btn btn-primary" href="/GruposUi/Asignar?solicitudId=@sol.Id">
            <i class="bi bi-person-plus"></i> Nueva asignación
        </a>
    </div>

    <!-- Listado de asignaciones -->
    <div class="card card-assign">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Asignaciones</h5>
                <span class="text-muted small">Solicitud #@sol.Id • @sol.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
            </div>
            <div id="assignList" class="row g-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (() => {
            const root = document.getElementById('vDetalle');
            const solicitudId = root.dataset.id;

            function estadoAsignacionLabel(n){
                // 0=Anulada, 1=Activa, 2=Finalizada (según tu enum)
                switch(Number(n)){
                    case 0: return {text:"Anulada", cls:"badge bg-secondary"};
                    case 1: return {text:"Activa", cls:"badge bg-success"};
                    case 2: return {text:"Finalizada", cls:"badge bg-primary"};
                    default: return {text:"-", cls:"badge bg-light text-dark"};
                }
            }

            function cardTemplate(a){
                const est = estadoAsignacionLabel(a.estado);
                const dtAsign = a.fechaAsignacionUtc ? new Date(a.fechaAsignacionUtc + 'Z') : null;
                const dtInicio = a.fecha_Inicio ? new Date(a.fecha_Inicio) : null;

                return `
                <div class="col-12 col-md-6 col-xl-4">
                  <div class="p-3 border rounded-4 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <div class="fw-semibold mb-1"><i class="bi bi-person-badge"></i> Técnico ID: ${a.fkTecnico}</div>
                        <div class="text-muted small">Grupo: <span class="chip">#${a.idGrupo}</span></div>
                      </div>
                      <span class="${est.cls}">${est.text}</span>
                    </div>

                    <div class="mt-2 small text-muted">
                      <div><i class="bi bi-calendar-check"></i> Asignado: ${dtAsign ? dtAsign.toLocaleString() + " UTC" : "-"}</div>
                      <div><i class="bi bi-calendar-event"></i> Visita: ${dtInicio ? dtInicio.toLocaleString() : "-"}</div>
                    </div>

                    ${a.notas ? `<div class="mt-2"><span class="text-muted small">Notas:</span><div class="border rounded p-2 bg-light">${a.notas}</div></div>` : ""}

                    <div class="mt-3 d-flex gap-2">
                      <button class="btn btn-sm btn-outline-danger" data-action="anular" data-id="${a.id}">
                        <i class="bi bi-x-circle"></i> Anular
                      </button>
                      <button class="btn btn-sm btn-primary" data-action="finalizar" data-id="${a.id}">
                        <i class="bi bi-check2-circle"></i> Finalizar
                      </button>
                    </div>
                  </div>
                </div>`;
            }

            async function loadAsignaciones(){
                const zone = document.getElementById('assignList');
                zone.innerHTML = `<div class="col-12 text-center py-4 text-muted">Cargando asignaciones…</div>`;
                try{
                    const r = await fetch(`/api/solicitudes/${solicitudId}/asignaciones`);
                    if(!r.ok){ zone.innerHTML = `<div class="col-12 text-danger">No se pudo cargar.</div>`; return; }
                    const list = await r.json();
                    if(!Array.isArray(list) || list.length === 0){
                        zone.innerHTML = `<div class="col-12 text-center text-muted py-4">No hay asignaciones aún.</div>`;
                        return;
                    }
                    zone.innerHTML = list.map(cardTemplate).join("");
                }catch(err){
                    console.error(err);
                    document.getElementById('assignList').innerHTML = `<div class="col-12 text-danger">Error de red.</div>`;
                }
            }

            async function patchEstado(asigId, estado, notaOpt){
                const body = { estado: estado, nota: notaOpt || "" };
                const r = await fetch(`/api/solicitudes/asignaciones/${asigId}/estado`, {
                    method: "PATCH",
                    headers: {"Content-Type":"application/json"},
                    body: JSON.stringify(body)
                });
                return r.ok;
            }

            // Delegación de eventos para Anular / Finalizar
            document.addEventListener('click', async (ev) => {
                const btn = ev.target.closest('button[data-action]');
                if(!btn) return;
                const id = btn.dataset.id;
                const action = btn.dataset.action;

                if(action === 'anular'){
                    const { value: nota } = await Swal.fire({
                        title: "Anular asignación",
                        input: "text",
                        inputLabel: "Motivo (opcional)",
                        inputPlaceholder: "Ej: Cliente reprograma",
                        showCancelButton: true,
                        confirmButtonText: "Anular",
                        cancelButtonText: "Cancelar",
                        icon: "warning"
                    });
                    if (nota === undefined) return;

                    const ok = await patchEstado(id, 0, nota ?? "");
                    if(ok){ await Swal.fire("Hecho","Asignación anulada.","success"); loadAsignaciones(); }
                    else { Swal.fire("Error","No se pudo anular.","error"); }
                }

                if(action === 'finalizar'){
                    const res = await Swal.fire({
                        title: "Finalizar asignación",
                        text: "¿Confirma que el trabajo fue finalizado?",
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonText: "Finalizar",
                        cancelButtonText: "Cancelar"
                    });
                    if(!res.isConfirmed) return;

                    const ok = await patchEstado(id, 2, "");
                    if(ok){ await Swal.fire("Hecho","Asignación finalizada.","success"); loadAsignaciones(); }
                    else { Swal.fire("Error","No se pudo finalizar.","error"); }
                }
            });

            document.addEventListener('DOMContentLoaded', loadAsignaciones);
        })();
    </script>
}
