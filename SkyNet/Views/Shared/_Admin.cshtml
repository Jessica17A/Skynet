@functions {
    bool IsActive(string controller)
    {
        var rc = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(rc, controller, StringComparison.OrdinalIgnoreCase);
    }
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SkyNet</title>

    <link rel="stylesheet" href="~/lib/coreui/dist/css/coreui.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/coreui/coreui@5.1.0/dist/css/coreui.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        /* Mantener sangría, pero hacer que el rectángulo activo se expanda */
        .sidebar .nav-group-items .nav-link {
            border-radius: .5rem;
            margin-left: -0.5rem;
            margin-right: -0.5rem;
        }

        .sidebar .nav-link.active {
            background-color: var(--cui-sidebar-nav-link-active-bg, rgba(255,255,255,.06));
            color: var(--cui-sidebar-nav-link-active-color, #fff);
        }

        .sidebar .nav-link:focus,
        .sidebar .nav-link:focus-visible {
            outline: 0;
            box-shadow: none;
        }
    </style>


    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- SIDEBAR -->
    <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
        <div class="sidebar-brand d-none d-md-flex">
            <div class="brand-wrap">
                <span class="brand-text">SkyNet</span>
            </div>
        </div>

        <ul class="sidebar-nav" data-coreui="navigation">
            <li class="nav-item">
                <a class="nav-link @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard
                    <span class="badge bg-info ms-auto">NEW</span>
                </a>
            </li>

            <li class="nav-title">Administración</li>

            <!-- Menú desplegable (NAV-GROUP) -->
            <li class="nav-item nav-group">
                <a class="nav-link nav-group-toggle" href="#" role="button">
                    <i class="bi bi-menu-button"></i> Gestión de usuarios🔻
                    
                </a>

                <ul class="nav-group-items">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
                            <i class="bi bi-person-plus-fill me-2"></i> Registrar usuarios
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Usuarios") ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-people-fill me-2"></i> Listar usuarios
                        </a>

                    </li>
                    
                </ul>
            </li>
          

            <li class="nav-item">
                <a class="nav-link @(IsActive("EmpleadosUi") ? "active" : "")"
                   asp-area="" asp-controller="EmpleadosUi" asp-action="Index">
                    <i class="bi bi-person-video2"></i> Empleados
                </a>
            </li>



            <li class="nav-title">Supervisores</li>
            <li class="nav-item">
                <a class="nav-link @(IsActive("GruposUi") ? "active" : "")"
                   asp-area="" asp-controller="GruposUi" asp-action="Index">
                    <i class="bi bi-person-video2"></i> Grupos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" target="_blank" href="https://coreui.io/docs/"><i class="bi bi-journal-code me-2"></i> Docs</a>
            </li>
        </ul>
    </div>

    <!-- WRAPPER -->
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <!-- HEADER -->
        <header class="header header-sticky mb-4">
            <div class="container-fluid d-flex align-items-center justify-content-between gap-3">
                <button class="header-toggler px-md-0 me-3" type="button"
                        onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="d-none d-md-block">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>

                <!-- Icons + User -->
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-link text-body" title="Notificaciones">
                        <i class="bi bi-bell fs-4"></i>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <!-- Botón/Avatar que ABRE el dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-link text-body d-flex align-items-center gap-2"
                                    type="button"
                                    id="userMenuBtn"
                                    data-coreui-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                                <span class="d-none d-sm-inline">@User.Identity?.Name</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuBtn">
                                <li class="dropdown-item-text"><strong>@User.Identity?.Name</strong></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                        <i class="bi bi-gear me-2"></i> Ajustes
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li class="px-2">
                                    <form method="post"
                                          asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "LayoutPrincipal", new { area = "" })">
                                        <button type="submit" class="dropdown-item w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-outline-primary btn-sm"
                               asp-area="Identity" asp-page="/Account/Register">Registrarse</a>
                            <a class="btn btn-primary btn-sm"
                               asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- BODY -->
        <div class="body flex-grow-1 px-3">
            <div class="container-lg">
                @RenderBody()
            </div>
        </div>

        <!-- FOOTER -->
        <footer class="footer">
            <div><strong>SkyNet</strong> © 2025</div>
           
        </footer>
    </div>

    <!-- JS CoreUI (local con respaldo CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/coreui/coreui@5.1.0/dist/js/coreui.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js" crossorigin="anonymous"></script>




    <script src="~/lib/coreui/dist/js/coreui.bundle.min.js"
            onerror="(function(){var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/@@coreui/coreui@5.1.0/dist/js/coreui.bundle.min.js';document.body.appendChild(s);}())"></script>

       <script>
            document.addEventListener('DOMContentLoaded', () => {
            // Asegura Sidebar
            const sidebarEl = document.getElementById('sidebar');
            if (sidebarEl && window.coreui?.Sidebar) {
                new coreui.Sidebar(sidebarEl);
            }

            // Asegura Navigation (submenús)
            const navEl = document.querySelector('.sidebar-nav');
            if (navEl && window.coreui?.Navigation) {
                new coreui.Navigation(navEl);
            }

            // Fallback ultra simple si el plugin Navigation no existe
            if (navEl && !window.coreui?.Navigation) {
                navEl.querySelectorAll('.nav-group-toggle').forEach(t => {
                    t.addEventListener('click', (e) => {
                        e.preventDefault();
                        const group = t.closest('.nav-group');
                        const list = t.nextElementSibling;
                        if (group && list && list.classList.contains('nav-group-items')) {
                            list.classList.toggle('show');
                        }
                    });
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
