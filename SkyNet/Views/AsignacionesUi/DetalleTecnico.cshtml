@model SkyNet.Models.DTOs.SolicitudAsignacionDetalleDto
@{
    ViewData["Title"] = "Detalle de asignación";
    Layout = "~/Views/Shared/_Tecnico.cshtml";

    const int EST_ACEPTADA = 3;
    const int EST_PROCESO = 4;
    const int EST_FIN = 5;

    string EstadoSolicitudTexto(int s) => s switch
    {
        1 => "Pendiente",
        2 => "Revisada",
        3 => "Aceptada",
        4 => "En proceso",
        5 => "Finalizada",
        _ => s.ToString()
    };

    string BadgeCss(int s) =>
        s == EST_ACEPTADA ? "bg-primary"
      : s == EST_PROCESO ? "bg-warning text-dark"
      : s == EST_FIN ? "bg-success"
      : "bg-light text-dark";
}

@if (Model == null)
{
    <div class="alert alert-warning text-center mt-4">
        <i class="bi bi-exclamation-triangle"></i> No se encontraron datos para esta asignación.
    </div>
}
else
{
    <div class="container mb-5" data-asignacion-id="@Model.AsignacionId">
        <!-- ENCABEZADO + BOTONES DE ACCIÓN -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="fw-bold text-primary mb-1">
                        <i class="bi bi-ticket-detailed"></i> Ticket @Model.Ticket
                    </h4>
                    <small class="text-muted">Creado el @Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</small>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="badge rounded-pill px-3 py-2 fs-6 @BadgeCss(Model.EstadoAsignacion)">
                        @EstadoSolicitudTexto(Model.EstadoAsignacion)
                    </span>

                    @* === Botones principales arriba === *@
                    @if (Model.EstadoAsignacion == EST_ACEPTADA)
                    {
                        <button id="btn-checkin" class="btn btn-primary fw-bold">
                            <i class="bi bi-play-circle"></i> Iniciar (Check-in)
                        </button>
                    }
                    else if (Model.EstadoAsignacion == EST_PROCESO)
                    {
                        <button id="btn-checkout" class="btn btn-warning fw-bold text-dark">
                            <i class="bi bi-stop-circle"></i> Finalizar
                        </button>
                    }
                    else if (Model.EstadoAsignacion == EST_FIN)
                    {
                        <button id="btn-reporte" class="btn btn-outline-danger fw-bold">
                            <i class="bi bi-file-earmark-pdf"></i> Ver reporte PDF
                        </button>

                        <a class="btn btn-outline-primary fw-bold"
                           asp-controller="Solicitudes"
                           asp-action="Historial"
                           asp-route-id="@Model.IdSolicitud">
                            <i class="bi bi-clock-history"></i> Ver tracking
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- INFO DE LA SOLICITUD -->
        <div id="detalleAsignacion" class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary">
                <i class="bi bi-info-circle"></i> Información de la solicitud
            </div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <p><strong>Nombre:</strong> @Model.Nombre</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Teléfono:</strong> @(Model.Telefono ?? "-")</p>
                </div>
                <div class="col-12">
                    <p><strong>Descripción:</strong></p>
                    <p class="border p-2 bg-light rounded">@Model.Descripcion</p>
                </div>
                <div class="col-12">
                    <p><strong>Dirección:</strong> @Model.Direccion</p>
                </div>
            </div>
        </div>

        <!-- INFO DE ASIGNACIÓN -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-success bg-opacity-10 fw-bold text-success">
                <i class="bi bi-person-gear"></i> Información de la asignación
            </div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <p><strong>Técnico asignado:</strong> @Model.TecnicoNombre</p>
                    <p><strong>Supervisor:</strong> @Model.SupervisorNombre</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Fecha de asignación:</strong> @Model.AsignacionCreadaUtc?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Inicio:</strong> @Model.AsignacionFechaInicio?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Finalización:</strong> @Model.AsignacionFechaFin?.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-12">
                    <p><strong>Notas:</strong></p>
                    <p class="border p-2 bg-light rounded">@(!string.IsNullOrWhiteSpace(Model.AsignacionNotas) ? Model.AsignacionNotas : "Sin notas registradas")</p>
                </div>
            </div>
        </div>

        <!-- MAPA -->
        @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-info bg-opacity-10 fw-bold text-info">
                    <i class="bi bi-geo-alt"></i> Ubicación aproximada
                </div>
                <div class="card-body text-center">
                    <iframe width="100%" height="300"
                            style="border:0; border-radius:.5rem;"
                            loading="lazy" allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade"
                            src="https://www.google.com/maps?q=@Model.Latitud,@Model.Longitud&hl=es&z=16&output=embed">
                    </iframe>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/reporteAsignacionCompleta.js"></script>

    <script>
        (() => {
            const apiRoot = '/api/solicitudes/asignaciones';
            const cont = document.querySelector('.container[data-asignacion-id]');
            const asigId = cont?.getAttribute('data-asignacion-id');
            const base = window.location.origin;

            async function patchEstado({ estado, nota = null, fechaFinIso = null }) {
                const url = `${base}${apiRoot}/${encodeURIComponent(asigId)}/estado`;
                const body = { Estado: estado };
                if (nota) body.Nota = nota;
                if (fechaFinIso) body.Fecha_Fin = fechaFinIso;

                const r = await fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
            }

            document.getElementById('btn-checkin')?.addEventListener('click', async (e) => {
                const btn = e.currentTarget; btn.disabled = true;
                try {
                    await patchEstado({ estado: 4 });
                    Swal.fire('Hecho', 'Asignación iniciada correctamente.', 'success').then(()=>location.reload());
                } catch (err) {
                    Swal.fire('Error', String(err), 'error');
                } finally { btn.disabled = false; }
            });

            document.getElementById('btn-checkout')?.addEventListener('click', async (e) => {
                const btn = e.currentTarget; btn.disabled = true;
                try {
                    const nowIso = new Date().toISOString();
                    const res = await Swal.fire({
                        title: 'Finalizar asignación',
                        input: 'textarea',
                        inputPlaceholder: 'Nota (opcional)',
                        showCancelButton: true,
                        confirmButtonText: 'Finalizar',
                    });
                    if (!res.isConfirmed) return;
                    await patchEstado({ estado: 5, nota: res.value, fechaFinIso: nowIso });
                    Swal.fire('Hecho', 'Asignación finalizada.', 'success').then(()=>location.reload());
                } catch (err) {
                    Swal.fire('Error', String(err), 'error');
                } finally { btn.disabled = false; }
            });

            // Generar PDF (archivo externo)
                document.getElementById('btn-reporte')?.addEventListener('click', async () => {
                generarReporteAsignacionCompleta(@Model.IdSolicitud);
        });

        })();
    </script>
}
