@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    :root {
        --azul: #1f4ae0;
        --borde: #e9ecef;
    }

    .auth-shell {
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 210px 100px 130px;
        background: #fff;
    }

    .login-card {
        width: 100%;
        max-width: 900px;
        border: 1px solid var(--borde);
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 35px rgba(0,0,0,.1);
    }

    .login-left {
        padding: 40px 32px;
    }

    .login-right {
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .login-right img {
            width: 100%;
            max-width: 300px;
            height: auto;
        }

    .title {
        color: var(--azul);
        font-weight: 700;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 10px;
        height: 3rem;
        padding-right: 2.5rem; /* espacio para el ojito */
    }

    .btn-login {
        background: var(--azul);
        border-color: var(--azul);
        color: #fff;
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        font-weight: 600;
    }

        .btn-login:hover {
            filter: brightness(.95);
        }

    /* Estilo del ojito dentro del input */
    .password-container {
        position: relative;
    }

        .password-container i {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            font-size: 1.1rem;
        }

            .password-container i:hover {
                color: var(--azul);
            }
</style>

<div class="auth-shell">
    <div class="login-card row g-0">
        <!-- Columna izquierda (formulario) -->
        <div class="col-lg-6 login-left">
            <h3 class="title">Acceso a Cuentas</h3>
            <form id="account" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label"></label>
                    <input asp-for="Input.UserName"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Nombre de usuario" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <!-- Contraseña -->
                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <div class="password-container">
                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Contraseña"
                               id="passwordInput" />
                        <i class="bi bi-eye" id="togglePassword"></i>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <button id="login-submit" type="submit" class="btn btn-login">Acceder</button>
            </form>
        </div>

        <!-- Columna derecha (logo/imagen) -->
        <div class="col-lg-6 login-right">
            <img src="~/img/logo1.png" alt="Logo" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');

        togglePassword.addEventListener('click', () => {
            const type = passwordInput.type === 'password' ? 'text' : 'password';
            passwordInput.type = type;
            togglePassword.classList.toggle('bi-eye');
            togglePassword.classList.toggle('bi-eye-slash');
        });
    </script>
}
