@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="mb-0">Usuarios</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i> Nuevo usuario
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped align-middle mb-0" id="tblUsers">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="d-none d-md-table-cell">Cargo</th>
                        <th>Usuario</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th class="d-none d-sm-table-cell">Roles</th>
                        <th class="d-none d-sm-table-cell">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (async function() {
            const apiBase = '@Url.Content("~/api/usuarios")';

            function renderSoloActivos(data) {
                const tbody = document.querySelector('#tblUsers tbody');
                tbody.innerHTML = '';

               
                const soloActivos = data.filter(u => Number(u.estado ?? -1) === 2);

                for (const u of soloActivos) {
                    const nombre = u.empleadoId
                        ? `${u.nombres ?? ''} ${u.apellidos ?? ''}`.trim()
                        : '<span class="text-muted">— sin enlace —</span>';

                    const roles = (u.roles ?? '').trim() || '<span class="text-muted">—</span>';
                    const estadoBadge = '<span class="badge bg-success">Activo</span>';

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${nombre}</td>
                        <td class="d-none d-md-table-cell">${u.cargo ?? ''}</td>
                        <td>${u.userName ?? ''}</td>
                        <td class="d-none d-lg-table-cell">${u.email ?? ''}</td>
                        <td class="d-none d-sm-table-cell">${roles}</td>
                        <td class="d-none d-sm-table-cell">${estadoBadge}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger"
                                    data-action="delete"
                                    data-id="${u.userId}"
                                    title="Desactivar (estado = 0)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                }

                if (soloActivos.length === 0) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td colspan="7" class="text-center text-muted">No hay usuarios activos.</td>`;
                    tbody.appendChild(tr);
                }
            }

            async function loadUsers() {
                const res = await fetch(apiBase, { cache: 'no-store' });
                if (!res.ok) throw new Error('No se pudo cargar usuarios');
                const data = await res.json();
                renderSoloActivos(data);
            }

            document.querySelector('#tblUsers tbody').addEventListener('click', async (ev) => {
                const btn = ev.target.closest('button[data-action]');
                if (!btn) return;

                const id = btn.getAttribute('data-id');
                const action = btn.getAttribute('data-action');

                try {
                    if (action === 'delete') {
                        if (!confirm('¿Desactivar este usuario (estado = 0)?')) return;

                        const resp = await fetch(`${apiBase}/${encodeURIComponent(id)}/estado`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ estado: 0 })
                        });

                        if (!resp.ok) throw new Error('No se pudo desactivar (actualizar estado a 0)');
                        await loadUsers(); 
                    }
                } catch (err) {
                    console.error(err);
                    alert(err.message || 'Error en la operación');
                }
            });

            // Inicial
            try { await loadUsers(); }
            catch (err) { console.error(err); alert(err.message || 'Error cargando usuarios'); }
        })();
    </script>
}
