@model SkyNet.Models.DTOs.SolicitudDto
@{
    ViewData["Title"] = "Detalle solicitud";
    Layout = "~/Views/Shared/_Admin.cshtml";

    string EstadoNombre(int e) => e switch
    {
        0 => "Rechazado",
        1 => "Pendiente",
        2 => "Revisada",
        3 => "Aceptada",
        4 => "En proceso",
        5 => "Finalizado",
        _ => "Desconocido"
    };
    string EstadoBadge(int e) => e switch
    {
        0 => "badge rounded-pill px-3 py-2 bg-danger",
        1 => "badge rounded-pill px-3 py-2 bg-secondary",
        2 => "badge rounded-pill px-3 py-2 bg-info",
        3 => "badge rounded-pill px-3 py-2 bg-success",
        4 => "badge rounded-pill px-3 py-2 bg-warning text-dark",
        5 => "badge rounded-pill px-3 py-2 bg-primary",
        _ => "badge rounded-pill px-3 py-2 bg-dark"
    };

    string PriClass(string? p) => (p ?? "").Trim().ToLower() switch
    {
        "alta" => "chip chip-lg bg-danger text-white",
        "media" => "chip chip-lg bg-warning text-dark",
        "baja" => "chip chip-lg bg-success text-white",
        _ => "chip chip-lg bg-light text-dark border"
    };

    var steps = new (int val, string name)[] {
        (1,"Pendiente"), (2,"Revisada"), (3,"Aceptada"), (4,"En proceso"), (5,"Finalizado")
    };
}

<style>
    /* Stepper */
    .flow-stepper {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .flow-dot {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        font-weight: 700;
        border: 2px solid var(--bs-border-color);
        background: #fff;
        color: #6c757d;
    }

        .flow-dot.done {
            background: #e7f1ff;
            color: #0d6efd;
            border-color: #cfe2ff;
        }

        .flow-dot.active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
        }

    .flow-label {
        font-size: .95rem;
        color: #495057;
        font-weight: 600;
    }

    .flow-link {
        width: 56px;
        height: 3px;
        background: var(--bs-border-color);
        border-radius: 2px;
    }

        .flow-link.done {
            background: #0d6efd;
        }

    /* Chips */
    .chip {
        display: inline-block;
        padding: .35rem .9rem;
        border-radius: 50px;
        font-size: .85rem;
        line-height: 1;
        background: #f0f4f8;
        color: #333;
        border: 1px solid #d1d9e6;
        box-shadow: 0 2px 4px rgba(0,0,0,.08);
        transition: transform .25s ease, background .25s ease, border-color .25s ease;
        cursor: default;
    }

        .chip:hover {
            background: #e1ecf4;
            border-color: #a7c7e7;
            transform: translateY(-2px);
        }

    .chip-lg {
        padding: .45rem 1rem;
        font-size: .95rem;
    }

    /* Botonera */
    .btn-pill {
        border-radius: 999px;
        padding: .45rem 1rem;
        font-weight: 600;
    }
</style>

<div class="container mt-4" id="solicitud" data-id="@Model.Id" data-estado="@((int)Model.Estado)">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-receipt"></i> Ticket <strong>@Model.Ticket</strong></h4>
        <span id="estadoBadge" class="@EstadoBadge((int)Model.Estado)">@EstadoNombre((int)Model.Estado)</span>
    </div>

    <!-- Stepper -->
    <div class="card mb-3">
        <div class="card-body">
            <div id="stepper" class="flow-stepper">
                @{
                    var curr = (int)Model.Estado;
                    for (var i = 0; i < steps.Length; i++)
                    {
                        var s = steps[i];
                        var dotCls = s.val < curr ? "flow-dot done" : (s.val == curr ? "flow-dot active" : "flow-dot");
                        <div class="d-flex align-items-center gap-2">
                            <div class="@dotCls">@s.val</div>
                            <div class="flow-label">@s.name</div>
                        </div>
                        if (i < steps.Length - 1)
                        {
                            var linkCls = steps[i].val < curr ? "flow-link done" : "flow-link";
                            <div class="@linkCls"></div>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Datos -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label fw-bold">Nombre</label><div>@Model.Nombre</div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Email</label><div>@Model.Email</div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Teléfono</label><div>@(Model.Telefono ?? "-")</div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Tipo</label><div><span class="@PriClass(Model.Prioridad)">@Model.Tipo</span></div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Prioridad</label><div><span class="@PriClass(Model.Prioridad)">@Model.Prioridad</span></div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Creado (UTC)</label><div>@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
                        <div class="col-md-3"><label class="form-label fw-bold">Dirección</label><div>@(Model.Direccion ?? "-")</div></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-bold">Descripción</label>
                    <div class="border rounded p-3 bg-light h-100" style="white-space:pre-wrap">@Model.Descripcion</div>
                </div>
                @if (Model.Latitud.HasValue && Model.Longitud.HasValue)
                {
                    <div class="col-12">
                        <label class="form-label fw-bold">Ubicación</label>
                        <div class="text-muted">Lat: @Model.Latitud, Lng: @Model.Longitud</div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer d-flex flex-wrap justify-content-between align-items-start">
            <div class="d-flex flex-column gap-2">
                <div class="fw-semibold">Siguientes pasos</div>
                <div class="section-hint">Acciones disponibles según el estado actual</div>
                <div id="acciones" class="d-flex flex-wrap gap-2"></div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm align-self-end">Volver</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (() => {
          
            const okFlag = '@(TempData["ok"] != null ? "1" : "0")';

            const estados = {
                0: { text: "Rechazado", cls: "badge bg-danger" },
                1: { text: "Pendiente", cls: "badge bg-secondary" },
                2: { text: "Revisada", cls: "badge bg-info" },
                3: { text: "Aceptada", cls: "badge bg-success" },
                4: { text: "En proceso", cls: "badge bg-warning text-dark" },
                5: { text: "Finalizado", cls: "badge bg-primary" }
            };

            function btnClassForState(state) {
                switch(state){
                    case 0: return 'btn btn-pill btn-outline-danger';
                    case 1: return 'btn btn-pill btn-info text-white';
                    case 2: return 'btn btn-pill btn-primary';
                    case 3: return 'btn btn-pill btn-success';
                    case 4: return 'btn btn-pill btn-warning text-dark';
                    case 5: return 'btn btn-pill btn-primary';
                    default: return 'btn btn-pill btn-outline-secondary';
                }
            }

            function siguiente(curr) {
                switch(curr){
                    case 1: return 2;
                    case 2: return 3;
                    case 3: return 4;
                    case 4: return 5;
                    default: return null;
                }
            }

            function renderBotones() {
                const cont = document.getElementById('solicitud');
                const id = cont.dataset.id;
                const curr = parseInt(cont.dataset.estado, 10);
                const zone = document.getElementById('acciones');
                zone.innerHTML = '';

                if (curr === 0 || curr === 5) return;

                const nxt = siguiente(curr);
                if (curr === 4) {
                    const bFin = document.createElement('button');
                    bFin.className = btnClassForState(5);
                    bFin.textContent = estados[5].text;
                    bFin.onclick = () => cambiarEstado(id, 5);
                    zone.appendChild(bFin);
                } else if (nxt !== null) {
                    const bNext = document.createElement('button');
                    bNext.className = btnClassForState(nxt);
                    bNext.textContent = estados[nxt].text;
                    bNext.onclick = () => cambiarEstado(id, nxt);
                    zone.appendChild(bNext);
                }

                if (curr === 1 || curr === 2) {
                    const bRej = document.createElement('button');
                    bRej.className = btnClassForState(0);
                    bRej.textContent = 'Rechazar';
                    bRej.onclick = () => cambiarEstado(id, 0);
                    zone.appendChild(bRej);
                }
            }

            async function cambiarEstado(id, nuevo) {
                const zone = document.getElementById('acciones');
                zone.querySelectorAll('button').forEach(b => b.disabled = true);

                try {
                if (nuevo === 3) {
                    const result = await Swal.fire({
                        title: "Asignar técnico",
                        text: "Para dar seguimiento a la solicitud, debe asignar un técnico",
                        icon: "info",
                        showCancelButton: true,
                        confirmButtonText: "Continuar",
                        cancelButtonText: "Cancelar",
                        reverseButtons: false
                    });

                    if (result.isConfirmed) {
                       window.location.href = `/AsignacionesUi/Asignar?solicitudId=${id}`;
                    }
                    return;
                }


                    const resp = await fetch(`/api/solicitudes/${id}/estado`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ estado: nuevo })
                    });

                    if (!resp.ok) {
                        Swal.fire("Error", "No se pudo actualizar el estado.", "error");
                        return;
                    }

                    const data = await resp.json();
                    const badge = document.getElementById('estadoBadge');
                    badge.className = estados[data.estado].cls;
                    badge.textContent = estados[data.estado].text;
                    document.getElementById('solicitud').dataset.estado = data.estado;

                    renderBotones();

                    Swal.fire({
                        title: "¡Actualizado!",
                        text: "El estado se cambió correctamente.",
                        icon: "success",
                        timer: 1500,
                        showConfirmButton: false
                    });
                } catch (e) {
                    console.error(e);
                    Swal.fire("Error", "Error de red al cambiar estado.", "error");
                } finally {
                    zone.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            document.addEventListener('DOMContentLoaded', () => {
                renderBotones();

             
                if (okFlag === "1") {
                    Swal.fire({
                        title: "¡Asignación creada!",
                        text: "La planificacion de la visita fue coordinada correctamente",
                        icon: "success",                      
                        showConfirmButton: true
                    });
                }
            });
        })();
    </script>
}

