@{
    ViewData["Title"] = "Mis técnicos";
    Layout = "~/Views/Shared/_Supervisor.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        .table td, .table th {
            vertical-align: middle;
            padding: .35rem .5rem;
        }

        .table th {
            white-space: nowrap;
        }

        .chip {
            display: inline-block;
            padding: .25rem .5rem;
            border-radius: 999px;
            background: #eef;
            border: 1px solid #cfe2ff;
            color: #084298;
            font-size: .85rem
        }
    </style>
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h4 class="mb-0"><i class="bi bi-person-badge"></i> Mis técnicos</h4>
        
    </div>

    <div id="contextoSolicitud" class="mb-3" style="display:none">
        <div class="alert alert-info py-2 px-3 mb-0">
            <i class="bi bi-info-circle"></i>
            Asignando técnico para solicitud <span id="ctxSolicitud" class="chip"></span>.
            Selecciona un técnico y pulsa <strong>Asignar</strong>.
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblMisTecnicos" class="table table-sm table-striped align-middle w-100">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th style="width:60px;"># Grupo</th>
                            <th class="text-start">Técnico</th>
                            <th class="text-start">Supervisor</th>
                            <th style="width:200px;">Creado (UTC)</th>
                            <th style="width:100px;">Estado</th>
                            <th style="width:130px;" class="acciones-col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        let dt;

        const solicitudId = new URLSearchParams(location.search).get('solicitudId');

      
        (function initContext(){
            if (solicitudId) {
                document.getElementById('contextoSolicitud').style.display = '';
                document.getElementById('ctxSolicitud').textContent = '#' + solicitudId;
            } else {
                
                document.querySelector('th.acciones-col')?.classList.add('d-none');
            }
        })();

        async function asignarTecnico(idSolicitud, fila) {
            try {
                const payload = {
                    idSolicitud: Number(idSolicitud),
                    idGrupo: fila.idGrupo,
                    fkTecnico: fila.fkTecnico ?? fila.idTecnico ?? null
                };

                if (!payload.fkTecnico) {
                    alert('No se encontró el ID del técnico en la fila. Ajusta la API para enviar fkTecnico/idTecnico.');
                    return;
                }

                const resp = await fetch(`/api/solicitudes/${idSolicitud}/asignaciones`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!resp.ok) {
                    const t = await resp.text();
                    alert('No se pudo asignar el técnico.\n' + t);
                    return;
                }

                alert('Técnico asignado correctamente.');
               
            } catch (err) {
                console.error(err);
                alert('Error de red al asignar el técnico.');
            }
        }

        function cargarMisTecnicos() {
            if (dt) dt.destroy();

        
            const colsBase = [
                { data: 'idGrupo', className: 'text-center' },
                { data: 'tecnicoNombre' },
                { data: 'supervisorNombre' },
                {
                    data: 'fechaCreacionUtc',
                    render: function (data) {
                        if (!data) return '';
                        const d = new Date(data);
                        const yyyy = d.getUTCFullYear();
                        const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
                        const dd = String(d.getUTCDate()).padStart(2, '0');
                        const hh = String(d.getUTCHours()).padStart(2, '0');
                        const mi = String(d.getUTCMinutes()).padStart(2, '0');
                        return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
                    },
                    className: 'text-center'
                },
                {
                    data: 'estado',
                    render: v => v
                        ? '<span class="badge bg-success">Activo</span>'
                        : '<span class="badge bg-secondary">Inactivo</span>',
                    className: 'text-center'
                }
            ];

        
            if (solicitudId) {
                colsBase.push({
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    width: '130px',
                    render: function (_data, _type, row) {
                        return `
                            <button type="button" class="btn btn-sm btn-primary btn-asignar"
                                    title="Asignar técnico" data-tecnico="${row.fkTecnico ?? row.idTecnico ?? ''}">
                                <i class="bi bi-person-plus"></i> Asignar
                            </button>
                        `;
                    }
                });
            } else {
                colsBase.push({
                    data: null,
                    orderable: false,
                    className: 'text-center d-none',
                    defaultContent: ''
                });
            }

            dt = $('#tblMisTecnicos').DataTable({
                ajax: {
                    url: '/api/grupos?mine=true',
                    dataSrc: ''
                },
                responsive: true,
                lengthChange: false,
                pageLength: 10,
                order: [[3, 'desc']],
                columns: colsBase,
                language: {
                    search: 'Buscar:',
                    paginate: { previous: 'Anterior', next: 'Siguiente' },
                    emptyTable: 'No hay registros disponibles'
                }
            });           
        }

        $(document).ready(cargarMisTecnicos);
    </script>
}
