<div class="p-3 rounded-0 bg-light shadow-sm mb-4 text-center">
    <h2 class="mb-0 fw-bold text-dark">
        <i class="bi bi-calendar2-week text-primary"></i> Visitas programadas
    </h2>
</div>

<!-- Filtro por estado -->
<div class="d-flex justify-content-end align-items-center gap-2 mb-4">
    <label for="f-estado" class="mb-0 fw-bold text-dark">Estado:</label>
    <select id="f-estado" class="form-select form-select-sm fw-bold text-dark" style="max-width:220px;">
        <option value="all" selected class="text-dark">Todas</option>
        <option value="proceso" class="text-dark">En proceso</option>
        <option value="aceptada" class="text-dark">Aceptadas</option>
    </select>
    <small id="count" class="text-muted ms-2"></small>
</div>

<!-- Cards -->
<div id="cards" class="row g-4 mt-4"></div>

<style>
    .chip {
        display: inline-flex;
        align-items: center;
        gap: .375rem;
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 999px;
        padding: .25rem .75rem;
        background: #f8f9fa;
        margin: .25rem .375rem .25rem 0;
        font-size: .9rem;
        font-weight: 500;
        color: #0d6efd;
        transition: all .2s ease
    }

        .chip:hover {
            background: #e9f3ff;
            transform: translateY(-2px);
            box-shadow: 0 2px 6px rgba(0,0,0,.08)
        }

    .icon-sm {
        font-size: 1rem;
        line-height: 1
    }

    .meta {
        font-size: .9rem;
        color: #6c757d
    }

    .card-status-badge {
        position: absolute;
        right: .75rem;
        top: .75rem
    }
</style>

<script>
    (() => {
      const base = `${window.location.origin}${document.body.getAttribute("data-pathbase") ?? ""}`;
      const $cards = document.getElementById('cards');
      const $fEstado = document.getElementById('f-estado');
      const $count = document.getElementById('count');

      const groupBySolicitud = (rows) => {
        const m = new Map();
        for (const a of rows) {
          if (!m.has(a.idSolicitud)) m.set(a.idSolicitud, []);
          m.get(a.idSolicitud).push(a);
        }
        return Array.from(m.entries());
      };

      const uniques = (arr) => [...new Set(arr)];

      function render(groups, filtro) {
        const filtered = groups.filter(([, asigs]) => {
          const isProceso = asigs.some(a => a.estado === 4);
          const isAcept   = asigs.some(a => a.estado === 3) && !isProceso;
          if (filtro === 'proceso')  return isProceso;
          if (filtro === 'aceptada') return isAcept;
          return true;
        });

        $count.textContent = filtered.length ? `${filtered.length} solicitud(es)` : '';

        if (!filtered.length) {
          $cards.innerHTML = `<div class="col-12"><div class="alert alert-info m-0">Sin resultados.</div></div>`;
          return;
        }

        $cards.innerHTML = filtered.map(([, asigs]) => {
          // Orden por nombre de técnico
          asigs.sort((x,y)=>(x.tecnicoNombre||'').localeCompare(y.tecnicoNombre||''));

          const chipsTecnicos = asigs.map(a => `
            <span class="chip">
              <i class="bi bi-person-badge-fill text-primary"></i>
              ${a.tecnicoNombre ?? a.fkTecnico}
            </span>
          `).join('');

          const supervisores = uniques(asigs.map(a => a.supervisorNombre ?? '-')).join(', ');

          // Fechas camelCase desde la API
          const inicioMin = asigs.reduce((acc,a)=>{
            const dt = a.fechaInicio ? new Date(a.fechaInicio) : null;
            return !dt ? acc : (!acc || dt < acc ? dt : acc);
          }, null);

          const isProceso = asigs.some(a => a.estado === 4);
          const isAcept   = asigs.some(a => a.estado === 3) && !isProceso;
          const badge = isProceso
            ? `<span class="badge bg-warning text-dark card-status-badge">En proceso</span>`
            : (isAcept ? `<span class="badge bg-success card-status-badge">Aceptada</span>` : ``);

          return `
            <div class="col-12 col-md-6 col-lg-3">
              <div class="card h-100 border-0 shadow rounded-4 position-relative">
                ${badge}
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <a class="h5 mb-0 text-decoration-none" href="${base}/AsignacionesUi/Detalle/${asigs[0].idSolicitud}">
                      <i class="bi bi-journal-text text-primary"></i>
                      <span class="fw-bold text-primary">Solicitud #${asigs[0].idSolicitud}</span>
                    </a>
                  </div>

                  <div class="meta mb-3">
                    <div>
                      <i class="bi bi-person-workspace text-warning"></i>
                      <strong>Supervisor(es):</strong> ${supervisores}
                    </div>
                    <div class="mt-1">
                      <i class="bi bi-calendar2-week text-success"></i>
                      <strong>Fecha de Visita:</strong> ${inicioMin ? inicioMin.toLocaleDateString() : '-'}
                    </div>
                  </div>

                  <div class="mb-3">
                    <div class="mb-1">
                      <i class="bi bi-people-fill text-primary"></i>
                      <strong>Técnicos:</strong>
                    </div>
                    <div>${chipsTecnicos}</div>
                  </div>

                  <div class="mt-auto">
                    <a class="btn btn-outline-primary w-100 fw-bold"
                       href="${base}/AsignacionesUi/Detalle/${encodeURIComponent(asigs[0].idSolicitud)}">
                       <i class="bi bi-eye"></i> Ver detalles
                    </a>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      async function init() {
        // Consumir la API filtrada por supervisor logueado
        const res = await fetch(`${base}/api/solicitudes/asignaciones/supervisor`);
        if (!res.ok) {
          $cards.innerHTML = `<div class="col-12"><div class="alert alert-danger">No se pudo cargar el listado.</div></div>`;
          return;
        }
        const data = await res.json();
        const groups = groupBySolicitud(data);

        render(groups, $fEstado.value);
        $fEstado.addEventListener('change', () => render(groups, $fEstado.value));
      }

      init();
    })();
</script>
