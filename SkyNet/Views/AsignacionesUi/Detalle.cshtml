@model List<SkyNet.Models.DTOs.SolicitudAsignacionListadoS>
@using SkyNet.Models.DTOs
@using SkyNet.Models          @* <- donde está el enum SolicitudEstado *@

@{
    Layout = "~/Views/Shared/_Admin.cshtml";
    var solicitud = ViewBag.Solicitud as SolicitudDto;

    // datos agregados para cabeceras/resumen
    var tecnicos = Model
        .Select(a => string.IsNullOrWhiteSpace(a.TecnicoNombre) ? $"ID: {a.FkTecnico}" : a.TecnicoNombre!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var supervisores = Model
        .Select(a => a.SupervisorNombre)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var fechas = Model.Where(a => a.Fecha_Inicio.HasValue).Select(a => a.Fecha_Inicio!.Value).ToList();
    DateTime? primeraVisita = fechas.Any() ? fechas.Min() : (DateTime?)null;

    bool esFinalizada = solicitud?.Estado == SolicitudEstado.Finalizado;
}

<!-- ===== Encabezado verde sólido ===== -->
<div class="rounded-4 p-3 text-white fw-bold text-center mb-4"
     style="background-color:#147A44;">
    <h4 class="mb-0">
        <i class="bi bi-people"></i>
        Detalles — Ticket <strong>@solicitud?.Ticket</strong>
    </h4>
</div>


<!-- ===== Resumen tarjetas ===== -->
<div class="row g-3 justify-content-center text-center mb-3">
    <div class="col-12 col-md-4">
        <div class="w-100 p-3 bg-white border rounded-3 shadow-sm">
            <div class="small d-flex justify-content-center align-items-center gap-2 mb-1 text-primary">
                <i class="bi bi-people-fill"></i><span>Técnicos</span>
            </div>
            <div class="fw-bold fs-4 text-primary">@tecnicos.Count</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="w-100 p-3 bg-white border rounded-3 shadow-sm">
            <div class="small d-flex justify-content-center align-items-center gap-2 mb-1 text-success">
                <i class="bi bi-calendar2-week"></i><span>Visita Programada</span>
            </div>
            <div class="fw-bold fs-5 text-success">@((primeraVisita?.ToString("dd/MM/yyyy HH:mm")) ?? "-")</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="w-100 p-3 bg-white border rounded-3 shadow-sm">
            <div class="small d-flex justify-content-center align-items-center gap-2 mb-2 text-warning">
                <i class="bi bi-shield-check"></i><span>Supervisor(es)</span>
            </div>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                @if (supervisores.Any())
                {
                    foreach (var s in supervisores)
                    {
                        <span class="badge rounded-pill bg-white border border-warning text-warning px-3 py-2">@s</span>
                    }
                }
                else
                {

                    <span class="text-warning">-</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== Tabla de técnicos asignados ===== -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check"></i> Técnicos asignados</h6>

        @if (!esFinalizada)
        {
            <button id="btnAgregarTec" class="btn btn-sm btn-success fw-bold">
                <i class="bi bi-person-plus"></i> Agregar técnico(s)
            </button>
        }
    </div>

    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Técnico</th>
                            <th>Visita</th>
                            <th>Notas</th>
                            <th>Estado</th>
                            @if (!esFinalizada)
                            {
                                <th class="text-end">Acción</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.OrderBy(x => x.Fecha_Inicio ?? DateTime.MaxValue))
                        {
                            var estClase = a.Estado == 0 ? "badge bg-secondary"
                            : a.Estado == 2 ? "badge bg-primary"
                            : a.Estado == 4 ? "badge bg-warning text-dark"
                            : a.Estado == 3 ? "badge bg-success"
                            : "badge bg-light text-dark";

                            var estTexto = a.Estado == 0 ? "Anulada"
                            : a.Estado == 2 ? "Finalizada"
                            : a.Estado == 4 ? "En proceso"
                            : a.Estado == 3 ? "Aceptada"
                            : "-";

                            <tr>
                                <td>@(a.TecnicoNombre ?? $"ID: {a.FkTecnico}")</td>
                                <td>@(a.Fecha_Inicio?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(a.Notas) ? "-" : a.Notas)</td>
                                <td><span class="@estClase">@estTexto</span></td>
                                @if (!esFinalizada)
                                {
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger btnAnular" data-id="@a.Id" title="Anular">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">Sin asignaciones.</div>
        }
    </div>

    <!-- CTA Tracking -->
    <div class="card-footer">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3"
             style="background:#f6fff9;border:1px solid #d2f4df;border-radius:16px;padding:1rem;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-flag-fill text-success fs-4"></i>
                <div>
                    <div class="fw-bold">Seguir con el tracking de la solicitud</div>
                    <div class="text-muted small">Revisa el flujo completo y avanza el estado</div>
                </div>
            </div>
            <a class="btn btn-success rounded-pill fw-bold d-inline-flex align-items-center gap-2"
               asp-controller="Solicitudes" asp-action="Details" asp-route-id="@solicitud?.Id">
                Ir al tracking <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>
</div>

<!-- ===== Modal (Bootstrap) agregar técnico ===== -->
<div class="modal fade" id="modalAgregarTec" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-person-plus"></i> Agregar técnico(s)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Selecciona técnico(s)</label>
                    <select id="sw-tecs" multiple class="form-select"></select>
                    <div class="form-text">Solo técnicos disponibles</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nota (opcional)</label>
                    <textarea id="notaTec" class="form-control" rows="2" placeholder="Instrucciones para el técnico"></textarea>
                </div>
               
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarTec" class="btn btn-success fw-bold">
                    <i class="bi bi-check-circle"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const base = `${window.location.origin}${document.body.getAttribute('data-pathbase') ?? ''}`;
            const solicitudId = '@(solicitud?.Id ?? 0)';
            const esFinalizada = @((esFinalizada ? "true" : "false"));

            // abrir modal
            document.getElementById('btnAgregarTec')?.addEventListener('click', () => {
                if (esFinalizada) return;
                const modal = new bootstrap.Modal(document.getElementById('modalAgregarTec'));
                modal.show();
            });

            // técnicos ya asignados (para deshabilitar en Select2)
            const asignados = new Set(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                                                    Model.Select(m => m.FkTecnico)
                                    )));

        // Select2 dentro del modal Bootstrap
        const $sel = $('#sw-tecs');
        $sel.select2({
            theme: 'bootstrap-5',
            placeholder: 'Selecciona técnico(s)',
            width: '100%',
            allowClear: true,
            closeOnSelect: false,
            dropdownParent: $('#modalAgregarTec'),
            ajax: {
                url: `${base}/api/grupos`,
                dataType: 'json',
                delay: 200,
                data: params => ({ mine: true, q: params.term || '' }),
                processResults: data => {
                    const items = Array.isArray(data) ? data : [];
                    const results = items.map(g => {
                        const idGrupo = g.idGrupo ?? g.IdGrupo;
                        const fkTec   = g.tecnicoId ?? g.FkTecnico;
                        const activo  = g.estado === true || g.estado === 1 || g.estado === "1";
                        if (!idGrupo || !fkTec || !activo) return null;
                        return {
                            id: `${idGrupo}|${fkTec}`,
                            text: g.tecnicoNombre ?? `Técnico ${fkTec}`,
                            disabled: asignados.has(Number(fkTec))
                        };
                    }).filter(Boolean);
                    return { results };
                }
            }
        });

         
                 // Guardar técnicos seleccionados
        document.getElementById('btnGuardarTec')?.addEventListener('click', async () => {
            const sel = $sel.val();
            const nota = (document.getElementById('notaTec').value || '').trim();

            if (!sel || sel.length === 0) {
                Swal.fire('Atención', 'Debes seleccionar al menos un técnico.', 'warning');
                return;
            }

            try {
            
                const tecs = sel.map(x => Number(String(x).split('|')[1])).filter(n => !Number.isNaN(n));

                // Llamar endpoint SP dbo.usp_Solicitud_Asignacion_AgregarTecnico
                const res = await fetch(`${base}/api/solicitudes/${encodeURIComponent(solicitudId)}/asignaciones/tecnicos`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tecnicos: tecs, nota })
                });

                const data = await res.json().catch(() => ({})); 

                if (!res.ok || data.ok === false) {
                    throw new Error(data.msg || `Error HTTP ${res.status}`);
                }

                await Swal.fire({ icon: 'success', title: data.msg || 'Técnico(s) agregado(s)', confirmButtonColor: '#1cc88a' });
                location.reload();

            } catch (e) {
                Swal.fire('Error', e.message || 'No se pudo agregar los técnicos.', 'error');
            }
        });


                   // Anular asignación (solo si no está finalizada)
        document.addEventListener('click', async (ev) => {
            const btn = ev.target.closest('.btnAnular');
            if (!btn || esFinalizada) return;

            const id = btn.dataset.id;
            const { value: nota } = await Swal.fire({
                title: 'Anular asignación',
                input: 'text',
                inputLabel: 'Motivo (opcional)',
                inputPlaceholder: 'Ej: Cliente reprograma',
                showCancelButton: true,
                confirmButtonText: 'Anular',
                cancelButtonText: 'Cancelar',
                icon: 'warning'
            });
            if (nota === undefined) return;

            try {
                // Llamar endpoint SP dbo.usp_Solicitud_Asignacion_Anular
                const r = await fetch(`${base}/api/solicitudes/asignaciones/${encodeURIComponent(id)}/anular`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nota: nota ?? '' })
                });

                const data = await r.json().catch(() => ({})); 

                if (!r.ok || data.ok === false) {
                    throw new Error(data.msg || `Error HTTP ${r.status}`);
                }

                await Swal.fire('Hecho', data.msg || 'Asignación anulada.', 'success');
                location.reload();

            } catch (e) {
                Swal.fire('Error', e.message || 'No se pudo anular la asignación.', 'error');
            }
        });

        })();
    </script>

}
